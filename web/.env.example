# Server-only URL. The browser never talks to Keystone directly.
KEYSTONE_API_URL=http://127.0.0.1:8000

# Name of the secure, HttpOnly cookie populated by your identity provider.
KEYSTONE_SESSION_COOKIE=keystone_access_token

# Local development only. Refused when NODE_ENV=production.
KEYSTONE_DEV_TOKEN=dev-creator
NEXT_PUBLIC_ENABLE_DEMO_PAYMENT=true
