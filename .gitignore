.venv/
__pycache__/
*.pyc
.env
out/
*.egg-info/
.keystone-key
keystone.db
.keystone-store/
web/node_modules/
web/.next/
web/coverage/
web/.env.local
web/*.tsbuildinfo

# Fetched, not committed: 6 MB of weights would sit in git history forever.
# Run `keystone sample-model` to install it.
web/public/sample-model/

# Local payment config; the address is public but the file is per-machine.
.env.payments

# Staged eval items. Held-out probes and elicitation prompts are the moat --
# a committed set is a burned one -- and even the public seeds are fetched at
# pin rather than vendored, so the revision in code stays the only source of
# truth about what ran.
suites/*/assets/

# Cached upstream pools. A convenience; the pin in staging.py is the record.
.keystone-cache/
