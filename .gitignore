.venv/
__pycache__/
*.pyc
.env
out/
*.egg-info/
.keystone-key
keystone.db
.keystone-store/
web/node_modules/
web/.next/
web/coverage/
web/.env.local
web/*.tsbuildinfo

# Fetched and staged locally, never committed. Run `keystone sample-model` to
# install the default checkpoint used by "Reload sample model".
web/public/sample-model/

# Local payment config; the address is public but the file is per-machine.
.env.payments

# Staged eval items. Held-out probes and elicitation prompts are the moat --
# a committed set is a burned one -- and even the public seeds are fetched at
# pin rather than vendored, so the revision in code stays the only source of
# truth about what ran.
#
# `benchmarks/` is committed and is NOT a reason to relax this. That directory
# is a deliberate published release; this one is what the gate actually runs,
# and the two have to be able to diverge -- otherwise a rotation cannot make
# the gating set fresh again.
suites/*/assets/

# Cached upstream pools. A convenience; the pin in staging.py is the record.
.keystone-cache/
